# Select development, staging, or production before starting the API.
APP_ENV=
# Human-readable application name.
APP_NAME=
# Structured logging threshold.
LOG_LEVEL=
# Build commit identifier included in logs and health output.
GIT_SHA=
# Pooled application-role database URL.
DATABASE_URL=
# Direct owner-role URL for migrations and database dumps only.
DATABASE_URL_DIRECT=
# Dedicated scheduler-role URL for its advisory lock.
DATABASE_URL_SCHEDULER=
# Read-only database-role URL when a read-only connection is used.
DATABASE_URL_READONLY=
# Disable prepared statement caching for pooler compatibility.
DB_DISABLE_PREPARED_CACHE=
# Maximum database connections in the API or worker pool.
DB_POOL_SIZE=
# Additional database connections allowed above the pool size.
DB_MAX_OVERFLOW=
# Application signing key; set a long random value outside this template.
SECRET_KEY=
# Fernet key used for encrypted application data.
ENCRYPTION_KEY=
# Idle session lifetime in minutes.
SESSION_IDLE_MINUTES=
# Absolute session lifetime in hours.
SESSION_ABSOLUTE_HOURS=
# Failed login attempts before lockout.
LOGIN_MAX_ATTEMPTS=
# Login lockout duration in minutes.
LOGIN_LOCKOUT_MINUTES=
# Login requests allowed per rate-limit window.
LOGIN_RATE_LIMIT_ATTEMPTS=
# Login rate-limit window in minutes.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=
# Comma-separated trusted proxy IP addresses or CIDRs; empty trusts none.
TRUSTED_PROXY_IPS=
# Telegram bot token if Telegram integration is configured.
TELEGRAM_BOT_TOKEN=
# Telegram webhook verification secret if configured.
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp application secret if configured.
WHATSAPP_APP_SECRET=
# WhatsApp verification token if configured.
WHATSAPP_VERIFY_TOKEN=
# Error-reporting DSN if configured.
SENTRY_DSN=
# Public application URL used to construct links.
PUBLIC_BASE_URL=
# Master switch for SMS outbox delivery; disabled unless explicitly enabled.
SMS_ENABLED=
# SMS provider endpoint required when SMS is enabled.
SMS_GATEWAY_URL=
# SMS provider credential required when SMS is enabled.
SMS_GATEWAY_API_KEY=
# SMS sender label if required by the provider.
SMS_SENDER_ID=
# SMS provider request timeout in seconds.
SMS_REQUEST_TIMEOUT_SECONDS=
# Outbox worker polling interval in seconds.
OUTBOX_POLL_INTERVAL_SECONDS=
# Outbox delivery claim lease in seconds.
OUTBOX_CLAIM_LEASE_SECONDS=
# Maximum delivery attempts before dead-lettering.
OUTBOX_MAX_ATTEMPTS=
# Initial outbox retry delay in seconds.
OUTBOX_RETRY_BASE_SECONDS=
# Maximum outbox retry delay in seconds.
OUTBOX_RETRY_MAX_SECONDS=
# Maximum outbox messages claimed per tenant per batch.
OUTBOX_BATCH_SIZE_PER_TENANT=
# Container image owner used by production Compose.
AJO_IMAGE_OWNER=
# Container image tag used by production Compose.
AJO_TAG=
# Host loopback port for the API publication.
AJO_API_PORT=
# Host loopback port for the web publication.
AJO_WEB_PORT=
# Enable database statement timing diagnostics when supported.
AJO_DB_TIMING=
# Backup working directory on the operator host.
BACKUP_ROOT=
# Minimum acceptable backup size in bytes.
BACKUP_MIN_BYTES=
# Number of daily backup snapshots to retain.
BACKUP_RETENTION_DAILY=
# Number of weekly backup snapshots to retain.
BACKUP_RETENTION_WEEKLY=
# Number of monthly backup snapshots to retain.
BACKUP_RETENTION_MONTHLY=
# Maximum permitted backup file size in MiB.
BACKUP_FILE_LIMIT_MB=
# Backup file-size warning threshold percentage.
BACKUP_FILE_WARN_PERCENT=
# Backup file-size failure threshold percentage.
BACKUP_FILE_FAIL_PERCENT=
# Expected offsite bucket capacity in GiB.
BACKUP_BUCKET_CAPACITY_GB=
# Offsite bucket capacity warning threshold percentage.
BACKUP_BUCKET_WARN_PERCENT=
# Maximum acceptable backup age in hours.
BACKUP_FRESHNESS_HOURS=
# S3-compatible offsite endpoint.
BACKUP_S3_ENDPOINT=
# S3-compatible offsite region.
BACKUP_S3_REGION=
# S3-compatible offsite access-key identifier.
BACKUP_S3_ACCESS_KEY_ID=
# S3-compatible offsite secret access key.
BACKUP_S3_SECRET_ACCESS_KEY=
# S3-compatible offsite bucket name.
BACKUP_S3_BUCKET=
# age recipient identity list for encrypted offsite backups.
BACKUP_AGE_RECIPIENTS=
# Slack webhook for backup alerts.
BACKUP_SLACK_WEBHOOK_URL=
# Telegram bot token for backup alerts.
BACKUP_TELEGRAM_BOT_TOKEN=
# Telegram chat identifier for backup alerts.
BACKUP_TELEGRAM_CHAT_ID=
