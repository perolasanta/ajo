# ---------- Ajo environment (copy to .env, never commit .env) ----------
APP_ENV=development            # development | staging | production
APP_NAME=ajo
LOG_LEVEL=INFO

# ---------- Neon (Frankfurt, aws-eu-central-1) ----------
# Pooled (-pooler host) as ajo_app: API and worker. ajo_app is created with SQL, NOT in the console.
DATABASE_URL=postgresql://ajo_app:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/ajo?sslmode=require
# Direct (no -pooler) as the owner role: Alembic migrations, scheduler, pg_dump
DATABASE_URL_DIRECT=postgresql://ajo_owner:CHANGE_ME@ep-xxxx.eu-central-1.aws.neon.tech/ajo?sslmode=require
# Optional: read-only role for reports and auditor exports
DATABASE_URL_READONLY=

# asyncpg prepared-statement cache. Keep true until scripts/neon_smoke_test.py proves otherwise.
DB_DISABLE_PREPARED_CACHE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------- Security ----------
SECRET_KEY=CHANGE_ME_LONG_RANDOM
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=

# ---------- Backups (offsite, outside Neon and the VPS) ----------
BACKUP_S3_BUCKET=
BACKUP_GPG_RECIPIENT=
